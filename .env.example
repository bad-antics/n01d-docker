# ─── Network ──────────────────────────────────────────────────────────────────
N01D_SUBNET=172.28.0.0/16
N01D_GATEWAY=172.28.0.1

# ─── AI / LLM Services ───────────────────────────────────────────────────────
OLLAMA_PORT=11434
WEBUI_PORT=3080
WEBUI_AUTH=false

# Agent Zero
AGENT_ZERO_PORT=3100
AGENT_ZERO_MODEL=dolphin-mistral:7b
AGENT_ZERO_UTIL_MODEL=dolphin-mistral:7b
